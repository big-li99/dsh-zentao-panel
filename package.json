{
  "name": "dsh-zentao-panel",
  "version": "0.4.0",
  "description": "DeepSeek Harness（DSH）禅道工作台插件：左侧栏全局面板查看指派给我的任务/Bug/需求，一键转为 DSH 对话上下文。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/big-li99/dsh-zentao-panel.git"
  },
  "homepage": "https://github.com/big-li99/dsh-zentao-panel#readme",
  "bugs": {
    "url": "https://github.com/big-li99/dsh-zentao-panel/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "zentao",
    "禅道"
  ]
}
